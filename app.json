{
  "expo": {
    "name": "GlobeProbe",
    "slug": "globeprobe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_icon/icon@1024.png",
    "scheme": "globeprobe",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FFF8EC",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.puneet.globeprobe",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icon/adaptive_foreground@1024.png",
        "backgroundImage": "./assets/app_icon/adaptive_background@1024.png",
        "backgroundColor": "#BFE6FF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash@1242.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8EC"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "GlobeProbe records the Detective's spoken answer so a grown-up can listen to it later."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "GlobeProbe uses the camera so you can add a photo to a mission or to your sky diary.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {},
    "extra": {
      "router": {},
      "eas": {
        "projectId": "23249924-bde4-48f6-8205-4c07a9847cd2"
      }
    }
  }
}
